EFG 2 R "Brandts-Holt, IJGT 93, Game 3" { "Player 1" "Player 2" }
"Game 3 of the sender-receiver signaling game experiment in :cite:p:`BraHol93`,
reanalyzed using agent quantal response equilibrium in :cite:p:`McKPal98`."

c "" 1 "(0,1)" { "Type A" 1/2 "Type B" 1/2 } 0
p "" 1 1 "(1,1)" { "I" "S" } 0
p "" 2 1 "(2,1)" { "C" "D" "E" } 0
t "" 1 "Outcome 1" { 45, 30 }
t "" 2 "Outcome 2" { 15, 0 }
t "" 3 "Outcome 3" { 30, 15 }
p "" 2 2 "(2,2)" { "C" "D" "E" } 0
t "" 4 "Outcome 4" { 30, 90 }
t "" 5 "Outcome 5" { 0, 15 }
t "" 6 "Outcome 6" { 45, 15 }
p "" 1 2 "(1,2)" { "I" "S" } 0
p "" 2 1 "(2,1)" { "C" "D" "E" } 0
t "" 7 "Outcome 7" { 30, 30 }
t "" 8 "Outcome 8" { 0, 45 }
t "" 9 "Outcome 9" { 30, 15 }
p "" 2 2 "(2,2)" { "C" "D" "E" } 0
t "" 10 "Outcome 10" { 45, 0 }
t "" 11 "Outcome 11" { 15, 30 }
t "" 12 "Outcome 12" { 30, 15 }
